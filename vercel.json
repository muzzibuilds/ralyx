{
  "functions": {
    "api/[[...route]].ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/webhooks/(.*)",
      "destination": "/api/webhooks/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/health/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}